<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily token-burn refresh. Template — tools/setup.sh fills the __PLACEHOLDERS__,
     installs it to ~/Library/LaunchAgents/ and loads it.
     Runs once a day; if the Mac is asleep at the scheduled time, launchd fires it on wake. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__PUBLISH_SH__</string>
  </array>

  <!-- launchd's PATH is minimal; add Homebrew so git/python3 and
       git-credential-osxkeychain resolve for the push. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>10</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>__LOG__</string>
  <key>StandardErrorPath</key>
  <string>__ERR_LOG__</string>
</dict>
</plist>
